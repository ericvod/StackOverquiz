{
  "name": "stackoverquiz",
  "version": "1.0.0",
  "description": "Backend REST API for a programming quiz platform — Bun + Elysia + PostgreSQL + Drizzle.",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Eric Dourado",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "admin:create": "bun run src/scripts/create-admin.ts",
    "lint": "bunx biome lint ./src",
    "lint:fix": "bunx biome lint --write ./src",
    "format": "bunx biome format --write ./src",
    "check": "bunx biome check ./src",
    "check:fix": "bunx biome check --write ./src",
    "typecheck": "bunx tsc --noEmit",
    "test": "bash ./scripts/test-db.sh",
    "test:fast": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --preload ./tests/setup/test-env.ts ./tests/unit",
    "test:integration": "bun test --preload ./tests/setup/test-env.ts ./tests/integration",
    "test:e2e": "bun test --preload ./tests/setup/test-env.ts ./tests/e2e",
    "test:db": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:${TEST_DB_PORT:-7204}/stackoverquiz_test} bunx drizzle-kit push --force && DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:${TEST_DB_PORT:-7204}/stackoverquiz_test} bun test --preload ./tests/setup/test-env.ts ./tests/integration ./tests/e2e",
    "ci": "bun run check && bun run typecheck",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:migrate:prod": "bun run src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@google-cloud/storage": "^7.19.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.27",
    "minio": "^8.0.7",
    "postgres": "^3.4.8"
  }
}
