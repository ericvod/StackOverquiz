# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=*

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stackoverquiz
DATABASE_SOCKET_PATH=

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-secret-with-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Object Storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=minio

# MinIO/local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stackoverquiz
MINIO_USE_SSL=false
# Public base URL rewrite for presigned URLs.
# Required when MinIO is behind a port mapping (e.g. docker dev where internal :9000 maps to host :7202).
# Leave empty when MINIO_ENDPOINT is already publicly reachable.
# Not used with STORAGE_DRIVER=gcs.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Google Cloud Storage/Cloud Run
GCS_PROJECT_ID=
GCS_BUCKET=

# ─── OAuth2.0 Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# ─── OAuth2.0 GitHub ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/v1/auth/github/callback

# ─── Seed (optional admin bootstrap) ─────────────────────────────────────────
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
